{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ES2022",
    "skipLibCheck": true
  }
}